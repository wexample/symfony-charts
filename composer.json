{
  "name": "wexample/symfony-charts",
  "description": "Charts for Symfony: chart points as entities, served by one list endpoint",
  "version": "4.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyCharts\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyCharts\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/php-pseudocode": ">=3.0.0",
    "wexample/symfony-api": ">=16.0.0",
    "wexample/symfony-helpers": ">=19.0.0",
    "wexample/symfony-pseudocode": ">=4.0.2",
    "symfony/uid": ">=6.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}